# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). Until these are set, the site runs on
# the built-in mock catalog (src/lib/mock-data.ts) — see README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser, never prefixed with NEXT_PUBLIC_.
# Used later for admin operations that must bypass RLS (e.g. bulk imports).
SUPABASE_SERVICE_ROLE_KEY=

# Added in Phase 3 (Stripe checkout + the 50% deposit / 50% on-arrival
# pre-order flow). Leave blank for now.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
